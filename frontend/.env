# ===============================
# Application
# ===============================
VITE_APP_NAME=IQARENA

# ===============================
# API (via IIS Reverse Proxy)
# ===============================
# DO NOT use http://IP:PORT here
# IIS will proxy /api to http://localhost:3000
VITE_API_URL=/api

# ===============================
# Static uploads (images, files)
# ===============================
# Backend serves /uploads
# IIS proxies it securely via HTTPS
VITE_IMG_API_URL=/uploads

# ===============================
# Environment
# ===============================
VITE_ENV=production
